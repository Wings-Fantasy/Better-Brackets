<idea-plugin>
    <id>com.hxshijie.betterBrackets</id>
    <name>Better Brackets</name>
    <vendor email="hxshijie@outlook.com" url="https://www.hxshijie.com">wings-fantasy</vendor>

    <description><![CDATA[
        <p><b>Better Brackets</b> is a clean, elegant, precise, and lightweight bracket pair colorizer plugin for IntelliJ-based IDEs.</p>

        <p><b>Better-Brackets (更好的括号)</b>: 简洁优雅、精准轻量的多层级括号色彩与结构辅助插件。</p>
        <p>为不同嵌套层级的括号（圆括号、方括号、花括号与泛型尖括号）赋予不同的颜色，帮助开发者快速理清代码结构。当嵌套层级超过调色板数量时，会自动循环平滑过渡。</p>

        <h3>✨ 核心特性 (Key Features)</h3>
        <ul>
            <li><b>多层级色彩循环映射</b>：深度区分圆括号 <code>( )</code>、方括号 <code>[ ]</code>、花括号 <code>{ }</code> 与泛型尖括号 <code>&lt; &gt;</code>，告别嵌套视觉混乱。</li>
            <li><b>语法树（PSI）精准感知</b>：基于 JetBrains 原生 AST 语法树解析，严谨识别语言结构，绝不误染字符串字面量或注释中的符号。</li>
            <li><b>层级缩进引导线 (Indent Guide)</b>：根据代码块嵌套深度自适应渲染垂直缩进线，层次分明。</li>
            <li><b>当前作用域高亮 (Scope Highlighting)</b>：光标所在代码块或标签起止边界实时动态高亮，快速定位逻辑范围。</li>
            <li><b>全自由调色板与即时预览</b>：支持可视化取色器、悬停删除、智能梯度补色，设置面板内嵌实时代码预览，所见即所得。</li>
        </ul>

        <h3>💻 深度多语言支持 (Supported Languages)</h3>
        <ul>
            <li><b>Java</b>：方法参数、条件分支、类型转换、数组声明与下标、代码块、泛型参数列表。</li>
            <li><b>Kotlin</b>：函数调用、控制流、索引访问、解构赋值、闭包体、泛型实参与类型约束。</li>
            <li><b>C / C++</b>：深度适配 CLion 与 Android Studio 原生环境，动态感知宿主特性。</li>
            <li><b>XML / HTML</b>：标签名与尖括号 <code>&lt;tag&gt;...&lt;/tag&gt;</code> 一体化配对着色。</li>
            <li><b>JavaScript / TypeScript</b>：箭头函数、分组表达式、对象字面量、解构语法及 TS 泛型参数。</li>
            <li><b>CSS</b>：媒体查询、伪类、<code>calc</code>/<code>var</code> 函数、属性选择器与样式声明块。</li>
            <li><b>Vue (SFC)</b>：单文件组件跨区深度协同，支持 Mustache 双花括号插值 <code>{{ }}</code> 专属着色。</li>
            <li><b>YAML</b>：行内列表与端口映射 <code>[ ]</code>、行内对象与环境配置 <code>{ }</code> 专属着色，自适应层级垂直缩进线与作用域高亮。</li>
            <li><b>JSON</b>：数组 <code>[ ]</code> 与对象 <code>{ }</code> 专属着色，自适应层级垂直缩进线与作用域高亮。</li>
        </ul>

        <h3>⚡ 轻量与高性能</h3>
        <p>纯原生异步高亮扩展架构，零多余体积包袱，极低资源占用，确保代码编辑与补全流畅无阻。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- 可选语言依赖：使插件在不同 IDE（CLion、WebStorm、PyCharm、IDEA 等）中均可无缝兼容安装运行 -->
    <depends optional="true" config-file="betterBrackets-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="betterBrackets-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="betterBrackets-js.xml">JavaScript</depends>
    <depends optional="true" config-file="betterBrackets-css.xml">com.intellij.css</depends>
    <depends optional="true" config-file="betterBrackets-vue.xml">org.jetbrains.plugins.vue</depends>
    <depends optional="true" config-file="betterBrackets-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="betterBrackets-json.xml">com.intellij.modules.json</depends>

    <resource-bundle>messages.BetterBracketsBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint name="braceSupport"
                        interface="com.hxshijie.betterBrackets.core.BracePairProvider"
                        dynamic="true"/>
    </extensionPoints>

    <!-- 平台基础语言支持：C/C++ 与 HTML/XML 在所有 JetBrains IDE（包括 CLion、IDEA 等）中均原生可用 -->
    <extensions defaultExtensionNs="com.hxshijie.betterBrackets">
        <braceSupport implementation="com.hxshijie.betterBrackets.support.cpp.CppBraceSupport"/>
        <braceSupport implementation="com.hxshijie.betterBrackets.support.html.HtmlBraceSupport"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                id="com.hxshijie.betterBrackets.settings"
                parentId="editor"
                groupWeight="175"
                instance="com.hxshijie.betterBrackets.settings.configurable.BetterBracketsConfigurable"
                key="settings.menu.main"/>

        <applicationConfigurable
                id="com.hxshijie.betterBrackets.settings.function"
                parentId="com.hxshijie.betterBrackets.settings"
                groupWeight="10"
                instance="com.hxshijie.betterBrackets.settings.configurable.BetterBracketsFunctionConfigurable"
                key="settings.menu.Function"/>

        <applicationConfigurable
                id="com.hxshijie.betterBrackets.settings.color"
                parentId="com.hxshijie.betterBrackets.settings"
                groupWeight="0"
                instance="com.hxshijie.betterBrackets.settings.configurable.BetterBracketsColorConfigurable"
                key="settings.menu.color"/>

        <highlightVisitor implementation="com.hxshijie.betterBrackets.core.highlighter.BetterBracketsHighlightVisitor"/>

        <highlightingPassFactory implementation="com.hxshijie.betterBrackets.support.cpp.CppIndentGuidePassFactory"/>
        <highlightingPassFactory implementation="com.hxshijie.betterBrackets.support.html.HtmlIndentGuidePassFactory"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>
</idea-plugin>
